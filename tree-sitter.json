{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "smarty",
      "camelcase": "Smarty",
      "title": "Smarty",
      "scope": "source.smarty",
      "file-types": [
        "tpl"
      ],
      "injection-regex": "^smarty$",
      "class-name": "TreeSitterSmarty"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Smarty template grammar (HTML + Smarty tags)",
    "authors": [
      {
        "name": "smarty-zed-support"
      }
    ],
    "links": {
      "repository": "https://github.com/"
    }
  },
  "bindings": {
    "c": true
  }
}
